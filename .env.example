# Copia este archivo a .env y ajusta los valores. Nunca subas .env a git.
DATABASE_URL=postgresql+psycopg://mnemo:mnemo@localhost:5433/mnemo
MODELO_EMBEDDINGS=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# LLM del Tutor: ollama (gratis, local) | anthropic (de pago) | falso (respuestas fijas)
PROVEEDOR_LLM=ollama
MODELO_OLLAMA=qwen2.5:3b
URL_OLLAMA=http://localhost:11434

# Solo si PROVEEDOR_LLM=anthropic
ANTHROPIC_API_KEY=
MODELO_ANTHROPIC=claude-sonnet-5-5

# ClickHouse (analítica). Deben coincidir con docker-compose.yml
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PUERTO=8123
CLICKHOUSE_USUARIO=mnemo
CLICKHOUSE_PASSWORD=mnemo

# Clave secreta para seudonimizar estudiantes (HMAC-SHA256). Genera la tuya con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Si la cambias, los seudónimos antiguos dejan de coincidir con los nuevos.
CLAVE_SEUDONIMOS=
